<mxCell id="note49" value="Modality Rules&#xa;Book requires exactly 1 ClerkUser.&#xa;BookSegment requires exactly 1 Book and 1 ClerkUser.&#xa;VoiceSession requires exactly 1 Book and 1 ClerkUser.&#xa;Book may have 0..N segments and 0..N sessions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9b2a7;fontSize=13;fontColor=#333333;spacing=10;" vertex="1" parent="1">
  <mxGeometry x="60" y="500" width="390" height="170" as="geometry" />
</mxCell>
<mxCell id="note50" value="Weak Entities&#xa;BookSegment is existence-dependent on Book.&#xa;VoiceSession is existence-dependent on Book and ClerkUser for billing-period usage tracking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9b2a7;fontSize=13;fontColor=#333333;spacing=10;" vertex="1" parent="1">
